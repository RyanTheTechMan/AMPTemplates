Console.ActivateLogRegex=
Console.UserActions={"Kick":"kick {{username}} Removed through AMP","Ban 1 hour":"ban character {{username}} 1h Banned through AMP","Ban 1 day":"ban character {{username}} 1d Banned through AMP"}
