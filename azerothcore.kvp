Meta.DisplayName=AzerothCore
Meta.Description=AzerothCore Wrath of the Lich King 3.3.5a server with standard and Playerbots distributions
Meta.OS=Linux
Meta.AarchSupport=Unknown
Meta.Arch=x86_64
Meta.Author=RyanTheTechMan
Meta.URL=https://www.azerothcore.org/
Meta.DisplayImageSource=url:https://avatars.githubusercontent.com/u/20147732?s=256
Meta.EndpointURIFormat=
Meta.ConfigManifest=azerothcoreconfig.json
Meta.MetaConfigManifest=
Meta.ConfigRoot=azerothcore.kvp
Meta.MinAMPVersion=2.7.2.8
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=True
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Required
Meta.ContainerPolicyReason=AzerothCore is compiled from source and runs an instance-local MySQL, authserver, and worldserver stack. AMP's primary Debian container (currently Debian 13) provides a consistent supported toolchain and runtime on Linux or Windows Docker hosts.
Meta.ExtraSetupStepsURI=https://github.com/RyanTheTechMan/AMPTemplates/blob/main/AZEROTHCORE.md
Meta.ResourceUsageInfo=Normal AzerothCore: 4 CPU and 8-12 GB RAM recommended. Playerbots: 6 CPU and 16 GB RAM minimum, with 24-32 GB preferred for larger bot populations. Allow roughly 20 GB free disk; the first source compile is CPU/RAM intensive.
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["build-essential","binutils","ccache","libtool","cmake-data","ninja-build","cmake","clang","git","curl","wget","jq","unzip","xz-utils","ca-certificates","procps","lsb-release","pkg-config","openssl","openssl-provider-legacy","file","gawk","util-linux","tzdata","libaio1t64","libncurses6","libnuma1","libboost-all-dev","libssl-dev","libreadline-dev","zlib1g-dev","libbz2-dev","libncurses-dev","liblzma-dev","google-perftools","libgoogle-perftools-dev"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=9
Meta.ReleaseNotes=v9 Debian 13 OpenSSL runtime fix and clearer update completion: adds the separately packaged openssl-provider-legacy module required for WoW 3.3.5a RC4, pins OPENSSL_MODULES to Debian's provider directory, validates legacy.so before launch, and prints an unmistakable INSTALL/UPDATE COMPLETE marker after updates. Retains passwordless private MySQL Unix sockets, Active Users plus Playerbots-only Bots Online metrics, stable readiness checks, Playerbots, player tracking, moderation, versions and modules.
Meta.BreakingReleaseNotes=
Meta.AppConfigId=5fcd02aa-1117-4d8e-9a48-25c2f112bbd9
Meta.OriginalSource=RyanTheTechMan-AMPTemplates
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False
