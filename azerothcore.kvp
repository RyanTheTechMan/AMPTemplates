App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"PATH":"{{$FullBaseDir}}mysql/bin:%PATH%","LD_LIBRARY_PATH":"{{$FullBaseDir}}mysql/lib:{{$FullBaseDir}}mysql/lib/private:%LD_LIBRARY_PATH%","MYSQL_UNIX_PORT":"{{$FullBaseDir}}run/mysqld/mysqld.sock","AC_DISABLE_INTERACTIVE":"1","AC_FORCE_CREATE_DB":"1","AC_CLOSE_IDLE_CONNECTIONS":"0","AC_UPDATES_ENABLE_DATABASES":"7","AC_DATA_DIR":"{{$FullBaseDir}}dist/bin","AC_LOGS_DIR":"{{$FullBaseDir}}logs","AC_TEMP_DIR":"{{$FullBaseDir}}temp","AC_SOURCE_DIRECTORY":"{{$FullBaseDir}}source","AC_MYSQL_EXECUTABLE":"{{$FullBaseDir}}mysql/bin/mysql","AC_REALM_SERVER_PORT":"{{$AuthPort}}","AC_WORLD_SERVER_PORT":"{{$WorldPort}}","AC_BIND_IP":"{{$ApplicationIPBinding}}","AC_PLAYER_LIMIT":"{{$MaxUsers}}","AC_MOTD":"{{Motd}}","AC_GAME_TYPE":"{{GameType}}","AC_START_PLAYER_LEVEL":"{{StartPlayerLevel}}","AC_RATE_XP_KILL":"{{RateXPKill}}","AC_RATE_XP_QUEST":"{{RateXPQuest}}","AC_RATE_XP_EXPLORE":"{{RateXPExplore}}","AC_RATE_DROP_MONEY":"{{RateMoney}}","AC_RATE_DROP_ITEM_POOR":"{{RateDropItem}}","AC_RATE_DROP_ITEM_NORMAL":"{{RateDropItem}}","AC_RATE_DROP_ITEM_UNCOMMON":"{{RateDropItem}}","AC_RATE_DROP_ITEM_RARE":"{{RateDropItem}}","AC_RATE_DROP_ITEM_EPIC":"{{RateDropItem}}","AC_RATE_DROP_ITEM_LEGENDARY":"{{RateDropItem}}","AC_RATE_DROP_ITEM_ARTIFACT":"{{RateDropItem}}","AC_RATE_DROP_ITEM_REFERENCED":"{{RateDropItem}}","AC_RATE_REPUTATION_GAIN":"{{RateReputationGain}}","AC_MAP_UPDATE_THREADS":"{{MapUpdateThreads}}","AC_NETWORK_THREADS":"{{NetworkThreads}}","AC_AI_PLAYERBOT_ENABLED":"1","AC_AI_PLAYERBOT_RANDOM_BOT_AUTOLOGIN":"{{PlayerbotsRandomBotAutologin}}","AC_AI_PLAYERBOT_MIN_RANDOM_BOTS":"{{PlayerbotsMinRandomBots}}","AC_AI_PLAYERBOT_MAX_RANDOM_BOTS":"{{PlayerbotsMaxRandomBots}}","AC_AI_PLAYERBOT_DISABLED_WITHOUT_REAL_PLAYER":"{{PlayerbotsDisabledWithoutRealPlayer}}","AC_AI_PLAYERBOT_MAX_ADDED_BOTS":"{{PlayerbotsMaxAddedBots}}","AC_AI_PLAYERBOT_ADD_CLASS_ACCOUNT_POOL_SIZE":"{{PlayerbotsAddClassAccountPoolSize}}","AC_AI_PLAYERBOT_RANDOM_BOT_ACCOUNT_COUNT":"{{PlayerbotsRandomBotAccountCount}}","AC_AI_PLAYERBOT_COMMAND_SERVER_PORT":"0","AMP_ACORE_REALM_NAME":"{{RealmName}}","AMP_ACORE_REALM_ADDRESS_MODE":"{{RealmAddressMode}}","AMP_ACORE_AUTO_REALM_ADDRESS":"{{$ExternalIP}}","AMP_ACORE_MANUAL_REALM_ADDRESS":"{{ManualRealmAddress}}","AMP_ACORE_REALM_LOCAL_ADDRESS":"{{RealmLocalAddress}}","AMP_ACORE_REALM_LOCAL_SUBNET_MASK":"{{RealmLocalSubnetMask}}","AMP_ACORE_AUTH_PORT":"{{$AuthPort}}","AMP_ACORE_WORLD_PORT":"{{$WorldPort}}","AMP_ACORE_MYSQL_BUFFER_POOL_MB":"{{MySQLBufferPoolMB}}","AMP_ACORE_ENABLE_CHAT_FEED":"{{EnableAMPChatFeed}}","AMP_ACORE_METRICS_INTERVAL_SECONDS":"{{MetricsIntervalSeconds}}","AMP_ACORE_START_PLAYER_MONEY_GOLD":"{{StartPlayerMoneyGold}}","AC_SKIP_CINEMATICS":"{{SkipCinematics}}","AC_PLAYER_START_STRING":"{{PlayerStartMessage}}","AC_SERVER_LOGIN_INFO":"{{ServerLoginInfo}}","AC_RATE_HONOR":"{{RateHonor}}","AC_RATE_ARENA_POINTS":"{{RateArenaPoints}}","AC_RATE_REWARD_QUEST_MONEY":"{{RateQuestMoney}}","AC_RATE_REWARD_BONUS_MONEY":"{{RateQuestBonusMoney}}","AMP_ACORE_RATE_CREATURE_HEALTH":"{{RateCreatureHealth}}","AMP_ACORE_RATE_CREATURE_DAMAGE":"{{RateCreatureDamage}}","AMP_ACORE_RATE_CREATURE_SPELL_DAMAGE":"{{RateCreatureSpellDamage}}","AC_NO_RESET_TALENTS_COST":"{{NoResetTalentsCost}}","AC_INSTANCE_IGNORE_LEVEL":"{{InstanceIgnoreLevel}}","AC_INSTANCE_IGNORE_RAID":"{{InstanceIgnoreRaid}}","AC_INSTANCE_RESET_TIME_HOUR":"{{InstanceResetTimeHour}}","AC_ALLOW_TWO_SIDE_ACCOUNTS":"{{AllowCrossFactionAccounts}}","AMP_ACORE_ALLOW_CROSS_FACTION_INTERACTION":"{{AllowCrossFactionInteraction}}","AC_PLAYER_SAVE_INTERVAL":"{{PlayerSaveIntervalSeconds}}","AC_PLAYER_SAVE_ADDITIONAL_SAVES":"{{PlayerSaveAdditionalSaves}}","AC_WARDEN_ENABLED":"{{WardenEnabled}}","AMP_ACORE_STRICT_VERSION_CHECK":"{{StrictVersionCheck}}","AMP_ACORE_WRONG_PASS_MAX_COUNT":"{{WrongPassMaxCount}}","AMP_ACORE_WRONG_PASS_BAN_TIME":"{{WrongPassBanTimeSeconds}}","AMP_ACORE_WRONG_PASS_BAN_TYPE":"{{WrongPassBanType}}","AMP_ACORE_WRONG_PASS_LOGGING":"{{WrongPassLogging}}","AMP_ACORE_ENABLE_PROXY_PROTOCOL":"{{EnableProxyProtocol}}","AMP_ACORE_ALLOW_LOGGING_IP_ADDRESSES":"{{AllowLoggingIPAddresses}}","AC_ALLOW_IP_BASED_ACTION_LOGGING":"{{AllowIPBasedActionLogging}}","AC_MAX_CORE_STUCK_TIME":"{{MaxCoreStuckTimeSeconds}}","AC_THREAD_POOL":"{{WorldThreadPool}}","AC_COMPRESSION":"{{CompressionLevel}}","AC_AI_PLAYERBOT_BOT_AUTOLOGIN":"{{PlayerbotsBotAutologin}}","AC_AI_PLAYERBOT_ALLOW_ACCOUNT_BOTS":"{{PlayerbotsAllowAccountBots}}","AC_AI_PLAYERBOT_ALLOW_GUILD_BOTS":"{{PlayerbotsAllowGuildBots}}","AC_AI_PLAYERBOT_ALLOW_TRUSTED_ACCOUNT_BOTS":"{{PlayerbotsAllowTrustedAccountBots}}","AC_AI_PLAYERBOT_DISABLED_WITHOUT_REAL_PLAYER_LOGIN_DELAY":"{{PlayerbotsDisabledLoginDelaySeconds}}","AC_AI_PLAYERBOT_DISABLED_WITHOUT_REAL_PLAYER_LOGOUT_DELAY":"{{PlayerbotsDisabledLogoutDelaySeconds}}","AC_AI_PLAYERBOT_RANDOM_BOTS_PER_INTERVAL":"{{PlayerbotsRandomBotsPerInterval}}","AC_AI_PLAYERBOT_RANDOM_BOT_UPDATE_INTERVAL":"{{PlayerbotsRandomBotUpdateInterval}}","AC_AI_PLAYERBOT_GROUP_INVITATION_PERMISSION":"{{PlayerbotsGroupInvitationPermission}}","AC_AI_PLAYERBOT_ADD_CLASS_COMMAND":"{{PlayerbotsAddClassCommand}}","AC_AI_PLAYERBOT_RANDOM_BOT_GUILD_COUNT":"{{PlayerbotsRandomBotGuildCount}}","AC_AI_PLAYERBOT_RANDOM_BOT_GUILD_SIZE_MAX":"{{PlayerbotsRandomBotGuildSizeMax}}","AC_AI_PLAYERBOT_RANDOM_BOT_INVITE_PLAYER":"{{PlayerbotsRandomBotInvitePlayer}}","AC_AI_PLAYERBOT_RANDOM_BOT_TALK":"{{PlayerbotsRandomBotTalk}}","AC_AI_PLAYERBOT_RANDOM_BOT_EMOTE":"{{PlayerbotsRandomBotEmote}}","AC_AI_PLAYERBOT_ENABLE_BROADCASTS":"{{PlayerbotsEnableBroadcasts}}"}
