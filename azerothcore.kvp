Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=
Console.AppReadyRegex=^AMP_AZEROTHCORE_READY$
Console.UserJoinRegex=^Account: (?<userid>\d+) \(IP: (?<endpoint>[^)]+)\) Login Character:\[(?<username>[^\]]+)\] \([^)]*\) Level: \d+$
Console.UserLeaveRegex=^Account: (?<userid>\d+) \(IP: (?<endpoint>[^)]+)\) Logout Character:\[(?<username>[^\]]+)\] \([^)]*\) Level: \d+$
Console.UserChatRegex=^(?:Leader player|Player) (?<username>\S+) (?:(?:says|emotes|yells) \(language \d+\)|whisper [^:]+|tells (?:party|raid|bg) with leader [^:]+|sends raid warning raid with leader [^:]+|tells guild(?:\.officer)? "[^"]*"|tells channel [^:]+): (?<message>.+)$
Console.UpdateAvailableRegex=^$
Console.PreConnectRegex=
Console.ConnectIPRegex=
Console.MetricsRegex=^AMP_AZEROTHCORE_METRICS BotsOnline=(?<Bots_Online>\d+)$
Console.ServerInfoRegex=^AMP_AZEROTHCORE_INFO Distribution=(?<Distribution>\S+) CoreRef=(?<Core_Ref>\S+) CoreCommit=(?<Core_Commit>\S+) Modules=(?<Modules>\d+) ClientData=(?<Client_Data>\S+) MySQL=(?<MySQL>\S+)$
Console.ServerAuthURLPromptRegex=
Console.ServerAuthAckRegex=
Console.ConsoleFormatRegex=
Console.DownloadProgressRegex=
Console.HideFromConsoleRegex=
